### ===================================
### LISTAR TODOS OS GATOS
### ===================================

GET http://localhost:3000/gatos

###

### ===================================
### BUSCAR GATO POR ID
### ===================================

GET http://localhost:3000/gatos/1

###

### ===================================
### CRIAR GATO
### ===================================

POST http://localhost:3000/gatos
Content-Type: application/json

{
  "nome_gato": "Nina",
  "idade": "2 meses",
  "sexo": "F",
  "cor": "Cinza",
  "porte": "Pequeno",
  "temperamento": "Carinhosa",
  "status": "Disponivel",
  "historico_tratamento": "Vacinada"
}

###

### ===================================
### ATUALIZAR GATO
### ===================================

PUT http://localhost:3000/gatos/1
Content-Type: application/json

{
  "nome_gato": "Luna Atualizada",
  "idade": "4 meses",
  "sexo": "F",
  "cor": "Branco",
  "porte": "Pequeno",
  "temperamento": "Calma",
  "status": "Disponivel",
  "historico_tratamento": "Vacinada e Vermifugada"
}

###

### ===================================
### DELETAR GATO
### ===================================

DELETE http://localhost:3000/gatos/3

###

### ===================================
### CASO INVÁLIDO - BUSCAR GATO QUE NÃO EXISTE
### ===================================

GET http://localhost:3000/gatos/999

###

### ===================================
### CASO INVÁLIDO - CRIAR GATO SEM DADOS
### ===================================

POST http://localhost:3000/gatos
Content-Type: application/json

{
  "nome_gato": "",
  "idade": "",
  "sexo": ""
}

### ===================================
### CASO INVÁLIDO - ATUALIZAR GATO INEXISTENTE
### ===================================

PUT http://localhost:3000/gatos/999
Content-Type: application/json

{
  "nome_gato": "Teste",
  "idade": "1 ano",
  "sexo": "M",
  "cor": "Preto",
  "porte": "Médio",
  "temperamento": "Calmo",
  "status": "Disponivel",
  "historico_tratamento": "Nenhum"
}

### ===================================
### CASO INVÁLIDO - DELETAR GATO INEXISTENTE
### ===================================

DELETE http://localhost:3000/gatos/999

### ===================================
### AUTENTICAÇÃO - CADASTRAR USUÁRIO
### ===================================

POST http://localhost:3000/auth/register
Content-Type: application/json

{
  "nome": "Gisely",
  "endereco": "João Pessoa",
  "contato": "gisely@gmail.com",
  "senha": "Senha123",
  "perfil": "usuario"
}

###

### ===================================
### AUTENTICAÇÃO - CADASTRAR ADMINISTRADOR
### ===================================

POST http://localhost:3000/auth/register
X-Admin-Key: COLOCAR_CHAVE_ADMINISTRATIVA
Content-Type: application/json

{
  "nome": "Administrador",
  "endereco": "João Pessoa",
  "contato": "admin@rescatto.com",
  "senha": "Senha789",
  "perfil": "admin"
}

###

### ===================================
### AUTENTICAÇÃO - CADASTRO COM EMAIL EXISTENTE
### ===================================

POST http://localhost:3000/auth/register
Content-Type: application/json

{
  "nome": "Gisely 2",
  "endereco": "João Pessoa",
  "contato": "gisely@gmail.com",
  "senha": "Senha456",
  "perfil": "usuario"
}

###

### ===================================
### AUTENTICAÇÃO - LOGIN CORRETO
### ===================================

POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "contato": "gisely@gmail.com",
  "senha": "Senha123"
}

###

### ===================================
### AUTENTICAÇÃO - LOGIN COM SENHA ERRADA
### ===================================

POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "contato": "gisely@gmail.com",
  "senha": "senhaerrada"
}

###

### ===================================
### AUTENTICAÇÃO - LOGIN COM USUÁRIO INEXISTENTE
### ===================================

POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "contato": "naoexiste@gmail.com",
  "senha": "Senha123"
}

###

### ===================================
### ROTA PROTEGIDA - SEM TOKEN
### ===================================

GET http://localhost:3000/auth/perfil

###

### ===================================
### ROTA PROTEGIDA - COM TOKEN
### ===================================

GET http://localhost:3000/auth/perfil
Authorization: Bearer COLAR_TOKEN

###

### ===================================
### ROTA PROTEGIDA - CRIAR GATO COM TOKEN
### ===================================

POST http://localhost:3000/gatos
Authorization: Bearer COLAR_TOKEN
Content-Type: application/json

{
  "nome_gato": "Nina protegida",
  "idade": "2 meses",
  "sexo": "F",
  "cor": "Cinza",
  "porte": "Pequeno",
  "status": "Disponivel"
}

