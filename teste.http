### ===================================
### LISTAR TODOS OS GATOS
### ===================================

GET http://localhost:3000/gatos

###

### ===================================
### BUSCAR GATO POR ID
### ===================================

GET http://localhost:3000/gatos/1

###

### ===================================
### CRIAR GATO
### ===================================

POST http://localhost:3000/gatos
Content-Type: application/json

{
  "nome_gato": "Nina",
  "idade": "2 meses",
  "sexo": "F",
  "cor": "Cinza",
  "porte": "Pequeno",
  "temperamento": "Carinhosa",
  "status": "Disponivel",
  "historico_tratamento": "Vacinada"
}

###

### ===================================
### ATUALIZAR GATO
### ===================================

PUT http://localhost:3000/gatos/1
Content-Type: application/json

{
  "nome_gato": "Luna Atualizada",
  "idade": "4 meses",
  "sexo": "F",
  "cor": "Branco",
  "porte": "Pequeno",
  "temperamento": "Calma",
  "status": "Disponivel",
  "historico_tratamento": "Vacinada e Vermifugada"
}

###

### ===================================
### DELETAR GATO
### ===================================

DELETE http://localhost:3000/gatos/3

###

### ===================================
### CASO INVÁLIDO - BUSCAR GATO QUE NÃO EXISTE
### ===================================

GET http://localhost:3000/gatos/999

###

### ===================================
### CASO INVÁLIDO - CRIAR GATO SEM DADOS
### ===================================

POST http://localhost:3000/gatos
Content-Type: application/json

{
  "nome_gato": "",
  "idade": "",
  "sexo": ""
}

### ===================================
### CASO INVÁLIDO - ATUALIZAR GATO INEXISTENTE
### ===================================

PUT http://localhost:3000/gatos/999
Content-Type: application/json

{
  "nome_gato": "Teste",
  "idade": "1 ano",
  "sexo": "M",
  "cor": "Preto",
  "porte": "Médio",
  "temperamento": "Calmo",
  "status": "Disponivel",
  "historico_tratamento": "Nenhum"
}

### ===================================
### CASO INVÁLIDO - DELETAR GATO INEXISTENTE
### ===================================

DELETE http://localhost:3000/gatos/999

